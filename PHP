<?php

$num1 = $_POST["num1"] ?? 0;
$num2 = $_POST["num2"] ?? 0;

if (isset($_POST["calcular"])) {

    echo "Soma: " . ($num1 + $num2) . "<br>";
    echo "Subtração: " . ($num1 - $num2) . "<br>";
    echo "Multiplicação: " . ($num1 * $num2) . "<br>";

    if ($num2 != 0) {
        echo "Divisão: " . ($num1 / $num2);
    } else {
        echo "Divisão: não é possível dividir por zero.";
    }
}

